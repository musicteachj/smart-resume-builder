# --- Django server ---
SECRET_KEY=change-me-in-production
# DEBUG defaults to False (fail-closed). Local dev REQUIRES a repo-root .env with
# DEBUG=True — copy this file to .env to get started.
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Postgres (matches docker-compose.yml defaults)
DATABASE_URL=postgres://resume_user:resume_pass@localhost:5432/resume_builder

# CORS / frontend origin (Vite dev server)
CLIENT_URL=http://localhost:5173

# --- AI (Phase 7) ---
ANTHROPIC_API_KEY=

# Admin (unlimited AI calls) is granted per account, never by email at signup:
#   python server/manage.py set_admin you@example.com

# --- Google OAuth (Phase 11) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
