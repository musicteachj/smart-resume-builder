# --- Django server ---
SECRET_KEY=change-me-in-production
# DEBUG defaults to False (fail-closed). Local dev REQUIRES a repo-root .env with
# DEBUG=True; copy this file to .env to get started.
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Postgres (matches docker-compose.yml defaults). Required when DEBUG=False; under
# DEBUG it falls back to this local database.
DATABASE_URL=postgres://resume_user:resume_pass@localhost:5432/resume_builder

# CORS / frontend origin (Vite dev server). Under DEBUG it defaults to this value;
# with DEBUG=False an unset CLIENT_URL allows no cross-origin requests at all.
CLIENT_URL=http://localhost:5173

# Django admin (/admin/) is mounted under DEBUG, and in production only when this is
# True. Leave it off in production unless you need it.
# DJANGO_ADMIN_ENABLED=False

# --- AI (Phase 7) ---
ANTHROPIC_API_KEY=

# Admin (unlimited AI calls) is granted per account, never by email at signup:
#   python server/manage.py set_admin you@example.com

# Dollar spend ledger (defaults shown; 0 turns live AI off):
# AI_MONTHLY_BUDGET_USD=10
# AI_PACING_MULTIPLIER=3
# AI_DAILY_FLOOR_USD=0.50
# AI_VISITOR_BUDGET_USD=0.15
# Let the API re-run a request Sonnet 5.5 declines on Sonnet 5 inside the same call (billed, so the ledger reserves for both):
AI_SERVER_SIDE_FALLBACK=True

# --- Demo mode (public demo with guest accounts) ---
DEMO_MODE=False
# Cloudflare's always-pass Turnstile TEST keys, for local demo runs only. Real keys are
# required (and the test keys refused) whenever ALLOWED_HOSTS has a non-localhost host.
# TURNSTILE_SITE_KEY=1x00000000000000000000AA
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# --- Google OAuth (Phase 11) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
