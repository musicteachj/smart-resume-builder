# --- Django server ---
SECRET_KEY=change-me-in-production
# DEBUG defaults to False (fail-closed). Local dev REQUIRES a repo-root .env with
# DEBUG=True — copy this file to .env to get started.
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Postgres (matches docker-compose.yml defaults). Required when DEBUG=False; under
# DEBUG it falls back to this local database.
DATABASE_URL=postgres://resume_user:resume_pass@localhost:5432/resume_builder

# CORS / frontend origin (Vite dev server). Under DEBUG it defaults to this value;
# with DEBUG=False an unset CLIENT_URL allows no cross-origin requests at all.
CLIENT_URL=http://localhost:5173

# Django admin (/admin/) is mounted under DEBUG, and in production only when this is
# True. Leave it off in production unless you need it.
# DJANGO_ADMIN_ENABLED=False

# --- AI (Phase 7) ---
ANTHROPIC_API_KEY=

# Admin (unlimited AI calls) is granted per account, never by email at signup:
#   python server/manage.py set_admin you@example.com

# --- Google OAuth (Phase 11) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
