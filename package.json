{
  "name": "smart-resume-builder",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "concurrently -c \"cyan,magenta\" \"pnpm --filter @smart-resume/client dev\" \"pnpm --filter @smart-resume/server dev\"",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "format": "pnpm -r format",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "concurrently": "^9.0.1",
    "prisma": "^7.0.0",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "@prisma/client": "^7.0.0"
  }
}
