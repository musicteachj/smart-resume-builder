    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@tanstack/react-query": "^5.108.3",
    "axios": "^1.21.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "docx": "^9.16.0",
    "lucide-react": "^1.77.0",
    "mammoth": "^1.12.0",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.3.1",
